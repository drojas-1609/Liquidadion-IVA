# Ejemplo de variables de entorno.
#
# TODOS los valores de este archivo son FICTICIOS y NO corresponden a ninguna
# base ni credencial real. Copiá este archivo a `.env` (ignorado por Git) y
# completá con tus datos. Nunca subas credenciales reales al repositorio.
#
# La base PostgreSQL está alojada en Supabase (proyecto tax-liquidator). Las
# cadenas de conexión reales se obtienen en:
#   Supabase -> Project Settings -> Database -> Connection string
#
# Prisma usa DOS conexiones (ver `datasource db` en prisma/schema.prisma):
#
#   DATABASE_URL  -> runtime de la app (Next.js en Netlify, serverless).
#                    Debe apuntar al pooler de Supabase (Supavisor) en modo
#                    transaction, puerto 6543, con pgbouncer=true y un
#                    connection_limit bajo. Es IPv4, apto para Netlify.
#
#   DIRECT_URL    -> solo para `prisma migrate` (aplicar/crear migraciones).
#                    Conexión directa/session, puerto 5432. En Netlify usar
#                    el session pooler (…pooler.supabase.com:5432), que es
#                    IPv4; la conexión directa db.<ref>.supabase.co:5432 es
#                    IPv6-only sin el add-on de IPv4.

DATABASE_URL="postgresql://postgres.ejemploref:CONTRASENA_EJEMPLO@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.ejemploref:CONTRASENA_EJEMPLO@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# ─────────────────────────────────────────────────────────────
# Supabase Auth (Tarea 3A). Valores por entorno (dev / preview / prod);
# se toman de: Supabase -> Project Settings -> API.
# ─────────────────────────────────────────────────────────────

#   NEXT_PUBLIC_SUPABASE_URL          -> https://<ref>.supabase.co
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY -> clave publicable / anon (segura para
#                                       el cliente; NO es secreta).
NEXT_PUBLIC_SUPABASE_URL="https://ejemploref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_EJEMPLO_no_real"

#   AUTH_PRODUCTION_ORIGIN  -> opcional. Solo en el entorno de PRODUCCIÓN, si el
#     sitio usa un dominio propio en vez de <algo>.netlify.app. Debe ser el
#     origin HTTPS exacto, sin barra final. Ej: https://app.tudominio.com
# AUTH_PRODUCTION_ORIGIN="https://app.ejemplo.com"

# ─────────────────────────────────────────────────────────────
# SOLO runtime local — NO van al repo, NO son NEXT_PUBLIC, NO se ponen en
# variables de Netlify salvo que una función server las necesite.
# ─────────────────────────────────────────────────────────────

#   SUPABASE_SERVICE_ROLE_KEY  -> clave service_role (SECRETA, bypassa RLS).
#     Solo la usa `scripts/bootstrap-owner.ts`, pasada en la línea de comando
#     de esa ejecución puntual. Nunca dejarla en un archivo versionado.
# SUPABASE_SERVICE_ROLE_KEY="service_role_EJEMPLO_no_real"

#   BOOTSTRAP_OWNER  -> poné "1" solo durante la corrida única de
#     `node scripts/bootstrap-owner.ts`. Fuera de eso, sin definir.
# BOOTSTRAP_OWNER="1"
