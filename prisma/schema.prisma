generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Espejo de auth.users. id = auth.users.id (UUID).
/// Tarea 3A: SIN FK ni trigger sobre el esquema auth (la migración debe ser
/// reproducible en una base shadow sin esquema auth). Integridad por bootstrap
/// + aplicación + verificacion de huerfanos (scripts/check-orphan-profiles.ts).
/// `email` es copia de conveniencia, NO identidad ni clave de autorizacion.
model Profile {
  id        String   @id @db.Uuid
  email     String
  fullName  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships     Membership[]
  // Usuarios del estudio: invitaciones emitidas por este Profile (SetNull: la
  // invitación sobrevive al borrado de quien invitó; la autoría queda en AuditLog).
  sentInvitations OrganizationInvitation[] @relation("InvitationInvitedBy")

  createdClients              Client[]                    @relation("ClientCreatedBy")
  updatedClients              Client[]                    @relation("ClientUpdatedBy")
  createdPeriods              Period[]                    @relation("PeriodCreatedBy")
  updatedPeriods              Period[]                    @relation("PeriodUpdatedBy")
  closedPeriods               Period[]                    @relation("PeriodClosedBy")
  createdInvoices             Invoice[]                   @relation("InvoiceCreatedBy")
  updatedInvoices             Invoice[]                   @relation("InvoiceUpdatedBy")
  createdTaxRecords           TaxRecord[]                 @relation("TaxRecordCreatedBy")
  updatedTaxRecords           TaxRecord[]                 @relation("TaxRecordUpdatedBy")
  createdPeriodVatSettings    PeriodVatSettings[]         @relation("PeriodVatSettingsCreatedBy")
  updatedPeriodVatSettings    PeriodVatSettings[]         @relation("PeriodVatSettingsUpdatedBy")
  createdVatCreditAdjustments PeriodVatCreditAdjustment[] @relation("VatCreditAdjustmentCreatedBy")
  updatedVatCreditAdjustments PeriodVatCreditAdjustment[] @relation("VatCreditAdjustmentUpdatedBy")
  closedLiquidationVersions     PeriodLiquidationVersion[] @relation("LiquidationVersionClosedBy")
  supersededLiquidationVersions PeriodLiquidationVersion[] @relation("LiquidationVersionSupersededBy")

  // Tarea 3B: actor de la traza de auditoría. onDelete: SetNull (el historial
  // sobrevive al borrado del Profile).
  auditLogs AuditLog[] @relation("ProfileAuditLogs")

  @@index([email])
}

enum Role {
  OWNER
  ADMIN
  ACCOUNTANT
  OPERATOR
  VIEWER
}

/// El estudio contable (Dero Company). Sin jerarquia Firm -> Organization.
model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  clients     Client[]
  settings    OrgSetting[]
  arcaPadron  ArcaPadronOrganization?

  // Usuarios del estudio: cupo de plazas. Ocupan plaza las Membership ACTIVE
  // (incluido el propietario) y las invitaciones PENDING no vencidas (ver
  // lib/users/seats.ts). CHECK en la base: seatLimit >= 1. El valor lo
  // provisionará el plan comercial (docs/usuarios/README.md); hoy se configura
  // por estudio.
  seatLimit   Int                      @default(5)
  invitations OrganizationInvitation[]

  // Tarea 3B: historial de auditoría de la organización. onDelete: Restrict
  // (una futura eliminación de Organization NO debe borrar en silencio su
  // historial; antes hay que definir política de conservación/archivo).
  auditLogs AuditLog[] @relation("OrgAuditLogs")
}

model Membership {
  id             String   @id @default(cuid())
  profileId      String   @db.Uuid
  organizationId String
  role           Role
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Usuarios del estudio. Defaults = acceso previo intacto: las membresías
  // existentes quedan ACTIVE, con todos los clientes y todos los módulos.
  // El OWNER tiene siempre alcance y módulos completos (lib/auth/permissions):
  // estas columnas no lo restringen. Un trigger impide dejar al estudio sin
  // OWNER activo (migración 20261104120000_studio_users_permissions).
  status      MembershipStatus @default(ACTIVE)
  clientScope ClientScope      @default(ALL)
  modules     AppModule[]      @default([CLIENTS, IVA, ARCA_PADRON])
  disabledAt  DateTime?

  profile      Profile            @relation(fields: [profileId], references: [id], onDelete: Cascade)
  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientAccess MembershipClient[]

  @@unique([profileId, organizationId])
  // Destino de la FK compuesta desde MembershipClient (misma organización).
  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([profileId])
}

enum MembershipStatus {
  ACTIVE
  DISABLED
}

enum ClientScope {
  ALL
  SELECTED
}

/// Módulos implementados que se pueden habilitar por usuaria. Un módulo nuevo
/// NO se agrega solo a las membresías existentes (fail-closed): lo habilita el
/// propietario.
enum AppModule {
  CLIENTS
  IVA
  ARCA_PADRON
}

/// Clientes visibles para una Membership con clientScope = SELECTED. FKs
/// compuestas con organizationId: imposible asignar un cliente de otro estudio.
/// Cascade: borrar el cliente o la membresía borra la asignación.
model MembershipClient {
  membershipId   String
  clientId       String
  organizationId String
  createdAt      DateTime @default(now())

  membership Membership @relation(fields: [membershipId, organizationId], references: [id, organizationId], onDelete: Cascade)
  client     Client     @relation(fields: [clientId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@id([membershipId, clientId])
  @@index([clientId])
  @@index([organizationId])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

/// Invitación por correo a sumarse al estudio. `email` normalizado (trim +
/// minúsculas). Vencida = PENDING con expiresAt <= now (no ocupa plaza).
/// Índice único parcial (sólo SQL): una sola PENDING por (organizationId, email).
/// Los permisos se copian a la Membership al aceptar; `clientIds` se vuelve a
/// filtrar contra los clientes vigentes del estudio en ese momento.
model OrganizationInvitation {
  id             String           @id @default(cuid())
  organizationId String
  email          String
  role           Role
  clientScope    ClientScope
  modules        AppModule[]
  clientIds      String[]
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime
  invitedById    String?          @db.Uuid
  /// auth.users.id devuelto por Supabase al invitar (null si la cuenta ya existía).
  authUserId     String?          @db.Uuid
  lastSentAt     DateTime?
  sendCount      Int              @default(0)
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    Profile?     @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([email])
}

/// Reemplazo conceptual del Settings global. En 3A no se inventan claves
/// fiscales ni se conecta /settings. `Settings` (global) se conserva intacto.
model OrgSetting {
  id             String   @id @default(cuid())
  organizationId String
  key            String
  value          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([organizationId])
}

model Client {
  id              String   @id @default(cuid())
  name            String
  cuit            String
  condition       String
  address         String?
  defaultIibbRate Decimal  @default(3.000000) @db.Decimal(9, 6)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Ficha del cliente (contactos e IIBB). Todo NULLABLE: los clientes
  // históricos quedan sin dato (información pendiente), sin valores ficticios.
  // Teléfono y email de CONTACTO confirmados por el estudio (no son domicilio
  // fiscal electrónico ni titularidad verificada).
  phone            String?
  contactEmail     String?
  // Categoría operativa de inscripción en Ingresos Brutos elegida por el
  // estudio. NULL = sin clasificar. Informativa: NO interviene en el cálculo
  // (la liquidación sigue usando defaultIibbRate).
  iibbRegistration ClientIibbRegistration?
  jurisdictions    ClientJurisdiction[]
  activities       ClientActivity[]

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdById    String?      @db.Uuid
  updatedById    String?      @db.Uuid
  createdBy      Profile?     @relation("ClientCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy      Profile?     @relation("ClientUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  periods      Period[]
  // Usuarias con alcance SELECTED que pueden ver este cliente.
  memberAccess MembershipClient[]

  @@unique([organizationId, cuit])
  // Tarea 3B: habilita que (id, organizationId) sea destino de FK compuesta
  // desde Period, impidiendo relaciones entre organizaciones distintas.
  @@unique([id, organizationId])
  @@index([organizationId])
}

/// Estado del período fiscal. Todo período nace OPEN.
enum PeriodStatus {
  OPEN
  CLOSED
}

model Period {
  id             String @id @default(cuid())
  month          Int
  year           Int
  clientId       String
  organizationId String

  // Tarea 3B: relación COMPUESTA. Un Period sólo puede referenciar un Client
  // de la MISMA organización (PostgreSQL rechaza cualquier otra combinación).
  client               Client                      @relation(fields: [clientId, organizationId], references: [id, organizationId], onUpdate: Cascade, onDelete: Restrict)
  invoices             Invoice[]                   @relation("InvoicePeriod")
  // Fase A (M1): destino de la FK (periodId, clientId, organizationId) que
  // garantiza en la base que Invoice.clientId coincide con el del período.
  invoicesByClient     Invoice[]                   @relation("InvoicePeriodClient")
  // Fase A: configuración de IVA del período (1:1, opcional).
  vatSettings          PeriodVatSettings?
  // Ajustes al crédito fiscal por contribuciones a la Seguridad Social (Portal
  // IVA → Ajustes al Crédito Fiscal). A lo sumo uno por régimen.
  vatCreditAdjustments PeriodVatCreditAdjustment[]
  taxRecords           TaxRecord[]
  /// Versiones cerradas de la liquidación (historial de cierres).
  liquidationVersions  PeriodLiquidationVersion[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid
  createdBy   Profile? @relation("PeriodCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   Profile? @relation("PeriodUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  // Cierre del período: bloquea en el servidor el alta, la edición y la baja
  // de su contenido (comprobantes, retenciones/percepciones, configuración de
  // IVA) y la baja del propio período (lib/period-lock). Consulta y
  // exportación siguen disponibles. NO congela la liquidación: se sigue
  // calculando con la alícuota IIBB vigente del cliente (Client.defaultIibbRate).
  // CHECK en la base: status = CLOSED <=> closedAt NOT NULL. closedById puede
  // quedar NULL aun cerrado (onDelete: SetNull del Profile). La reapertura
  // limpia closedAt y closedById.
  status     PeriodStatus @default(OPEN)
  closedAt   DateTime?
  closedById String?      @db.Uuid
  closedBy   Profile?     @relation("PeriodClosedBy", fields: [closedById], references: [id], onDelete: SetNull)

  @@unique([month, year, clientId])
  // Tarea 3B: destino de FK compuesta desde Invoice / TaxRecord.
  @@unique([id, organizationId])
  // Fase A (M1): destino de la FK compuesta Invoice(periodId, clientId, organizationId).
  @@unique([id, clientId, organizationId])
  // Índice EXPLÍCITO de la FK compuesta (Prisma/PostgreSQL no lo crean solos).
  @@index([clientId, organizationId])
  @@index([organizationId])
  // @@index([clientId]) se mantiene hasta confirmar en dev (EXPLAIN / pg_indexes)
  // que [clientId, organizationId] cubre el filtro por su primer campo.
  @@index([clientId])
}

/// Origen de un comprobante. IMPORT se usará cuando exista el importador
/// (fase C/E); hasta entonces todo comprobante es MANUAL.
enum InvoiceSource {
  MANUAL
  IMPORT
}

/// Comprobante de compra o venta.
///
/// Fase A — migración M1 (expand). Convivencia de dos representaciones:
///  - Columnas HEREDADAS (`date`, `type`, `entityName`, `entityCuit`, `vatRate`,
///    `netAmount`, `vatAmount`, `totalAmount`): semántica anterior, importes CON
///    signo (una nota de crédito se guardaba en negativo). El código las sigue
///    completando para que el código publicado anterior funcione y se pueda
///    volver atrás. `entityCuit` puede contener transitoriamente un número de
///    documento que no es CUIT (sólo compatibilidad). Se eliminan en M3.
///  - Columnas NUEVAS (nullable en M1): importes SIEMPRE positivos y en pesos;
///    el signo contable sale EXCLUSIVAMENTE de `voucherCode` (lib/arca/vouchers).
///    `voucherCode = NULL` significa "fila heredada sin representar": se lee con
///    `normalizeInvoiceRow` en modo heredado. M2 (contract) las hará NOT NULL.
///
/// Objetos que Prisma 6.19 NO representa y viven sólo en migration.sql
/// (protegidos por tests/schema/invoice-model-migration.test.ts; NUNCA aplicar
/// la salida de `prisma migrate diff`/`migrate dev` sin revisarla, porque
/// propondría borrarlos):
///  - índices únicos PARCIALES `Invoice_sales_voucher_key` y
///    `Invoice_purchases_voucher_key` (duplicados en todos los períodos del cliente);
///  - restricciones CHECK `Invoice_*_check`, `InvoiceVatLine_*_check` y
///    `PeriodVatSettings_*_check`.
/// La migración 20260925210133_invoice_counterparty_turiva_variant_expand agrega
/// otros CHECK sobre `counterpartyVatConditionCode`, `turivaRelationCode`,
/// `voucherVariant` y `lidSection` (protegidos por
/// tests/schema/invoice-counterparty-variant-migration.test.ts).
model Invoice {
  id             String    @id @default(cuid())
  // ── Columnas heredadas (ver arriba) ──────────────────────────────────────
  date           DateTime?
  type           String?
  pointOfSale    Int
  number         Int
  entityName     String?
  entityCuit     String?
  netAmount      Decimal   @db.Decimal(18, 2)
  vatRate        Decimal?  @db.Decimal(9, 6) // porcentaje: 21, 10.5, 2.5
  vatAmount      Decimal   @db.Decimal(18, 2)
  totalAmount    Decimal   @db.Decimal(18, 2)
  category       String
  periodId       String
  organizationId String

  // ── Modelo contable (Fase A, M1: nullable hasta M2) ──────────────────────
  clientId                          String?
  source                            InvoiceSource?
  /// Código oficial de tipo de comprobante (ARCA). Define el signo contable.
  voucherCode                       Int?
  /// Último número de un rango "desde/hasta"; NULL = comprobante único.
  numberTo                          Int?
  /// Fecha contable, sin hora ni zona horaria.
  voucherDate                       DateTime?      @db.Date
  counterpartyDocType               Int?
  /// Sólo dígitos.
  counterpartyDocNumber             String?
  counterpartyName                  String?
  currencyCode                      String?        @db.Char(3)
  exchangeRate                      Decimal?       @db.Decimal(19, 6)
  /// Σ netAmount de las líneas de IVA.
  taxedNetAmount                    Decimal?       @db.Decimal(18, 2)
  /// Σ vatAmount de las líneas de IVA (IVA liquidado).
  totalVatAmount                    Decimal?       @db.Decimal(18, 2)
  /// Crédito fiscal computable DIRECTO: Σ computableVatAmount de las líneas
  /// DIRECT_COMPUTABLE (0 en ventas). NO incluye el prorrateo global, que se
  /// determina por período (PeriodVatSettings.globalCoefficient).
  directComputableVatCreditAmount   Decimal?       @db.Decimal(18, 2)
  /// Crédito fiscal computable INFORMADO oficialmente (futura importación del
  /// Libro IVA Digital, Compras campo 21). Se conserva tal cual; NULL en carga manual.
  reportedComputableVatCreditAmount Decimal?       @db.Decimal(18, 2)
  /// Importe de una operación sin IVA discriminado. NO afirma que sea exenta
  /// ni no gravada.
  netWithoutVatBreakdownAmount      Decimal?       @db.Decimal(18, 2)
  nonTaxedAmount                    Decimal?       @db.Decimal(18, 2)
  exemptAmount                      Decimal?       @db.Decimal(18, 2)
  // Percepciones informadas EN el comprobante. Separadas de TaxRecord y fuera
  // del cálculo hasta la fase F.
  vatPerceptionAmount               Decimal?       @db.Decimal(18, 2)
  nationalPerceptionAmount          Decimal?       @db.Decimal(18, 2)
  iibbPerceptionAmount              Decimal?       @db.Decimal(18, 2)
  municipalPerceptionAmount         Decimal?       @db.Decimal(18, 2)
  internalTaxesAmount               Decimal?       @db.Decimal(18, 2)
  otherTaxesAmount                  Decimal?       @db.Decimal(18, 2)
  /// Base imponible de IIBB (sólo ventas; ≥ 0; sin IVA ni percepciones).
  /// Su determinación fiscal definitiva (jurisdicción, actividad, exenciones)
  /// se amplía en la fase F.
  grossIncomeTaxBaseAmount          Decimal?       @db.Decimal(18, 2)
  /// Total del comprobante en pesos (fórmula en lib/invoice-model.ts).
  voucherTotalAmount                Decimal?       @db.Decimal(18, 2)
  /// Reintegro Decreto 1043/2016 / Devolución IVA Turistas Extranjeros (TurIVA):
  /// Ventas campo 23, Compras campo 26. SEPARADO del IVA, percepciones,
  /// tributos y voucherTotalAmount; fuera del cálculo hasta la fase F.
  turivaRefundAmount                Decimal?       @db.Decimal(18, 2)
  /// Pestaña del Libro IVA Digital. TURIVA exige PeriodVatSettings.turivaIncluded.
  lidSection                        LidSection     @default(GENERAL)
  /// Código de operación (tabla oficial); reservado para la importación.
  operationCode                     String?        @db.Char(1)

  // ── PR B (expand): nullable, sin default ni backfill ─────────────────────
  /// Condición frente al IVA de la contraparte (tabla oficial "Tipos de
  /// responsables"). NULL = fila heredada o importada; obligatoria en nuevas
  /// altas manuales por aplicación.
  counterpartyVatConditionCode Int?
  /// Relación emisor-receptor TurIVA ("0001".."0006", con ceros). Obligatoria
  /// en nuevas altas manuales 195–197 por aplicación.
  turivaRelationCode           String? @db.VarChar(4)
  /// Variante elegida para 001–003 en nuevas cargas manuales: NONE |
  /// PAGO_EN_CBU_INFORMADA. NULL en todo otro caso. La clase y la leyenda de
  /// 051–053 se DERIVAN por código y fecha (lib/arca/voucher-legal-class.ts).
  voucherVariant               String? @db.VarChar(32)

  // ── Clasificaciones para la presentación (IVA Simple, "Apertura de otros
  // conceptos"). NULL = sin clasificar (pendiente de revisión del estudio):
  // nunca se infieren sin fundamento. CHECK en la base: las de ventas sólo en
  // ventas y las de compras sólo en compras (migración 20261107120000).
  /// Ventas: código de actividad ARCA (6 dígitos) de la operación.
  activityCode                 String?                @db.VarChar(6)
  /// Ventas: tipo de operación de la parte GRAVADA (1 o 2 de la apertura). La
  /// parte exenta o no gravada va siempre al tipo 3 (excepto exportaciones).
  saleOperationType            SaleOperationType?
  /// Ventas: tipo de sujeto comprador de la apertura. Se puede derivar de la
  /// condición frente al IVA oficial de la contraparte (lib/vat-export/classification).
  buyerType                    BuyerType?
  /// Compras: concepto del crédito fiscal (apertura de crédito fiscal).
  purchaseCreditConcept        PurchaseCreditConcept?
  /// Ventas: operación de dación en pago del Decreto 1145/09 (sólo
  /// beneficiarios del régimen). false = no lo es. Su débito va además a la
  /// columna "Débito Fiscal O.D.P." de la apertura.
  dationInPayment              Boolean                @default(false)

  // Tarea 3B: relación COMPUESTA. Una Invoice sólo puede referenciar un Period
  // de la MISMA organización.
  period       Period  @relation("InvoicePeriod", fields: [periodId, organizationId], references: [id, organizationId], onUpdate: Cascade, onDelete: Restrict)
  // Fase A (M1): además, el Period debe ser del MISMO cliente. Con clientId
  // NULL (filas del código anterior) PostgreSQL no la evalúa (MATCH SIMPLE).
  periodClient Period? @relation("InvoicePeriodClient", fields: [periodId, clientId, organizationId], references: [id, clientId, organizationId], onUpdate: Cascade, onDelete: Restrict)

  vatLines InvoiceVatLine[]
  /// Percepción registrada como TaxRecord a partir de este comprobante (a lo
  /// sumo una: índice único parcial). Evita contarla dos veces.
  linkedTaxRecords TaxRecord[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid
  createdBy   Profile? @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   Profile? @relation("InvoiceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  // Fase A (M1): destino de la FK compuesta desde InvoiceVatLine.
  @@unique([id, organizationId])
  // Índice EXPLÍCITO de la FK compuesta.
  @@index([periodId, organizationId])
  // Índice EXPLÍCITO de la FK (periodId, clientId, organizationId).
  @@index([periodId, clientId, organizationId])
  @@index([organizationId])
  // @@index([periodId]) se mantiene hasta confirmar cobertura del compuesto.
  @@index([periodId])
}

/// Neto e IVA de un comprobante para UNA alícuota (código oficial ARCA) y UNA
/// atribución del crédito fiscal. El porcentaje no se persiste: se deriva del
/// código (lib/arca/catalogs). Importes siempre positivos; el signo lo da el
/// comprobante. La atribución por línea es una clasificación INTERNA: los
/// archivos oficiales informan el crédito computable por comprobante.
model InvoiceVatLine {
  id                   String              @id @default(cuid())
  organizationId       String
  invoiceId            String
  vatRateCode          Int
  netAmount            Decimal             @db.Decimal(18, 2)
  vatAmount            Decimal             @db.Decimal(18, 2)
  /// Ventas: NOT_APPLICABLE. Compras: DIRECT_COMPUTABLE | DIRECT_NON_COMPUTABLE | GLOBAL_PRORATION.
  creditAllocation     VatCreditAllocation
  /// DIRECT_COMPUTABLE: 0..vatAmount · DIRECT_NON_COMPUTABLE: 0 ·
  /// GLOBAL_PRORATION y NOT_APPLICABLE: NULL (el prorrateo es por período).
  computableVatAmount  Decimal?            @db.Decimal(18, 2)
  /// true si el usuario corrigió el computable de una línea DIRECT_COMPUTABLE.
  computableOverridden Boolean             @default(false)
  createdAt            DateTime            @default(now())

  // Las líneas son parte del comprobante: se borran con él.
  invoice Invoice @relation(fields: [invoiceId, organizationId], references: [id, organizationId], onUpdate: Cascade, onDelete: Cascade)

  // Una línea por alícuota y atribución: admite dos conceptos al 21 % con
  // distinta atribución e impide duplicados accidentales.
  @@unique([invoiceId, vatRateCode, creditAllocation])
  @@index([invoiceId, organizationId])
  @@index([organizationId])
}

/// Atribución del crédito fiscal de una línea de IVA.
enum VatCreditAllocation {
  NOT_APPLICABLE
  DIRECT_COMPUTABLE
  DIRECT_NON_COMPUTABLE
  GLOBAL_PRORATION
}

/// Tipo de operación de la parte gravada de una venta ("Operaciones que generan
/// Débito Fiscal", campo 2, IVA Simple – Especificación de Importaciones
/// Apertura de otros conceptos): 1 venta de cosas muebles, obras, locaciones
/// y/o prestaciones de servicios · 2 venta de bienes de uso.
enum SaleOperationType {
  GOODS_SERVICES
  CAPITAL_GOODS
}

/// Tipo de sujeto comprador (misma apertura, campo 3): 1 responsables
/// inscriptos · 2 monotributistas · 3 consumidores finales, exentos y no alcanzados.
enum BuyerType {
  RESPONSABLE_INSCRIPTO
  MONOTRIBUTO
  CONSUMIDOR_FINAL_EXENTO_NO_ALCANZADO
}

/// Concepto del crédito fiscal ("Operaciones que generan Crédito Fiscal",
/// campo 1): 1 compras de bienes (excepto bienes de uso) · 2 locaciones ·
/// 3 prestaciones de servicios · 4 inversiones de bienes de uso.
enum PurchaseCreditConcept {
  GOODS
  LEASES
  SERVICES
  CAPITAL_GOODS
}

/// Naturaleza de una retención/percepción con el detalle de la importación
/// del F.2051 (F2051-IVA-especificacion-de-importaciones.pdf).
enum TaxRecordNature {
  RETENTION
  PERCEPTION
  CUSTOMS_PERCEPTION
}

/// Pestaña del Libro IVA Digital en la que se registra el comprobante.
enum LidSection {
  GENERAL
  TURIVA
}

/// Modalidad del crédito fiscal computable del período ("Datos iniciales"
/// del Libro IVA Digital).
enum CreditProrationMode {
  NONE
  DIRECT
  GLOBAL
  DIRECT_AND_GLOBAL
}

enum CoefficientStatus {
  PROVISIONAL
  DEFINITIVE
}

/// Configuración de IVA de un período fiscal (1:1 con Period, opcional).
/// Sin fila: modalidad NONE, TurIVA desactivado, sin coeficiente.
/// El ajuste anual del prorrateo NO se modela todavía (tendrá su propio
/// modelo por cliente y ejercicio).
model PeriodVatSettings {
  id                                String              @id @default(cuid())
  organizationId                    String
  periodId                          String              @unique
  creditProrationMode               CreditProrationMode @default(NONE)
  /// Coeficiente de prorrateo global (0..1). Obligatorio en GLOBAL / DIRECT_AND_GLOBAL.
  globalCoefficient                 Decimal?            @db.Decimal(11, 10)
  globalCoefficientStatus           CoefficientStatus?
  /// "Incluido en el Régimen TurIVA".
  turivaIncluded                    Boolean             @default(false)
  /// F.2051 "Saldo técnico a favor del contribuyente del período anterior".
  /// Lo carga el estudio desde la DJ anterior (no se deduce de otro período).
  /// CHECK en la base: >= 0.
  previousTechnicalBalance          Decimal             @default(0) @db.Decimal(18, 2)
  /// Referencia del origen (p. ej. "DJ F.2051 08/2026, transacción ...").
  previousTechnicalBalanceReference String?             @db.VarChar(120)
  /// F.2051 "Saldo a favor de libre disponibilidad del período anterior", neto
  /// de usos. Lo carga el estudio. CHECK en la base: >= 0.
  previousFreeBalance               Decimal             @default(0) @db.Decimal(18, 2)
  previousFreeBalanceReference      String?             @db.VarChar(120)

  // FK COMPUESTA: la configuración sólo puede referenciar un Period de la
  // MISMA organización. Se borra con el período (es parte de él).
  period Period @relation(fields: [periodId, organizationId], references: [id, organizationId], onUpdate: Cascade, onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid
  createdBy   Profile? @relation("PeriodVatSettingsCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   Profile? @relation("PeriodVatSettingsUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  // 1:1 con la FK compuesta (también es el índice explícito de la FK).
  @@unique([periodId, organizationId])
  @@index([organizationId])
}

/// Régimen del crédito fiscal por contribuciones a la Seguridad Social, con
/// los nombres del Portal IVA (Ajustes al Crédito Fiscal):
///  - LEY_27541_ANEXO_I: Ley 27.541 art. 21 y Anexo I (régimen general de
///    empleadores). Se suma al crédito fiscal, sin tope.
///  - LEY_27467_ART_91: Ley 27.467 art. 91 (3er art. s/n a continuación del
///    art. 24 de la ley de IVA): radiodifusión, señales y editoras. Se computa
///    antes que los demás créditos y hasta el débito fiscal del período; no
///    genera saldo a favor.
enum VatCreditAdjustmentRegime {
  LEY_27541_ANEXO_I
  LEY_27467_ART_91
}

/// Ajuste al crédito fiscal por contribuciones a la Seguridad Social de un
/// período. El estudio carga las contribuciones efectivamente abonadas
/// ("Crédito Fiscal" en el Portal IVA, informativo) y el importe computable
/// ("Crédito Fiscal Computable", el que entra en la liquidación). La app no
/// calcula porcentajes ni zonas. CHECK en la base: 0 <= computable <= contribuciones.
model PeriodVatCreditAdjustment {
  id                  String                    @id @default(cuid())
  organizationId      String
  periodId            String
  regime              VatCreditAdjustmentRegime
  contributionsAmount Decimal                   @db.Decimal(18, 2)
  computableAmount    Decimal                   @db.Decimal(18, 2)
  /// Referencia del origen (p. ej. "F.931 09/2026").
  reference           String?                   @db.VarChar(120)

  // FK COMPUESTA: sólo un Period de la MISMA organización; se borra con él.
  period Period @relation(fields: [periodId, organizationId], references: [id, organizationId], onUpdate: Cascade, onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid
  createdBy   Profile? @relation("VatCreditAdjustmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   Profile? @relation("VatCreditAdjustmentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([periodId, regime])
  @@index([periodId, organizationId])
  @@index([organizationId])
}

model TaxRecord {
  id             String   @id @default(cuid())
  date           DateTime
  type           String
  amount         Decimal  @db.Decimal(18, 2)
  description    String?
  periodId       String
  organizationId String

  // ── Detalle para el F.2051 (NULL en registros anteriores: se completa para
  // exportar). Diseño: F2051-IVA-especificacion-de-importaciones.pdf (12/11/2025).
  /// Retención, percepción o percepción aduanera. Sólo para tipos de IVA.
  nature           TaxRecordNature?
  /// Retenciones: impuesto del certificado (767 o 216 según corresponda).
  taxCode          Int?
  /// Código de régimen del certificado o de la percepción.
  regimeCode       Int?
  /// CUIT del agente (11 dígitos). No aplica a percepciones aduaneras.
  agentCuit        String?          @db.VarChar(11)
  /// CUIT intermediario (contribuyente cesionario), opcional.
  intermediaryCuit String?          @db.VarChar(11)
  /// Tipo de comprobante de la tabla del F.2051 (no la del Libro IVA Digital).
  voucherTypeCode  Int?
  /// Número del comprobante con el formato de esa tabla.
  voucherNumber    String?          @db.VarChar(20)
  /// Número de certificado de retención.
  certificateNumber String?         @db.VarChar(40)
  /// Percepción aduanera: liquidación o despacho 99-999-XXXX-999999-X.
  customsDocument  String?          @db.VarChar(24)
  /// Percepción tomada de un comprobante de compra (campo de percepciones de
  /// IVA): a lo sumo un TaxRecord por comprobante. RESTRICT: el comprobante no
  /// se borra mientras tenga la percepción vinculada.
  invoiceId        String?
  invoice          Invoice?         @relation(fields: [invoiceId, organizationId], references: [id, organizationId], onUpdate: Cascade, onDelete: Restrict)

  // Tarea 3B: relación COMPUESTA. Un TaxRecord sólo puede referenciar un Period
  // de la MISMA organización.
  period Period @relation(fields: [periodId, organizationId], references: [id, organizationId], onUpdate: Cascade, onDelete: Restrict)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid
  createdBy   Profile? @relation("TaxRecordCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   Profile? @relation("TaxRecordUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  // Índice EXPLÍCITO de la FK compuesta.
  @@index([periodId, organizationId])
  @@index([organizationId])
  // @@index([periodId]) se mantiene hasta confirmar cobertura del compuesto.
  @@index([periodId])
}

/// Versión CERRADA de la liquidación de un período (una por cada cierre). Se
/// escribe sólo en las transiciones de estado (cierre: alta; reapertura: se
/// marca reemplazada), bajo el mismo bloqueo del Period. Guarda lo necesario
/// para que un cambio posterior de la ficha, de los catálogos o del código no
/// altere en silencio lo cerrado:
///  - `summary`: liquidación, identificación del cliente y controles, como
///    texto decimal (JSON saneado, sin CUIT de contrapartes);
///  - `packageZip`: el paquete de presentación generado en el cierre, tal cual
///    se descarga (NULL si había bloqueos de exportación: `summary.blockers`);
///  - `contentHash`: huella del contenido del período al cerrar (comprobantes,
///    líneas, retenciones y configuración) para verificarlo al descargar.
/// Índice único parcial (sólo SQL): a lo sumo una vigente (supersededAt NULL)
/// por período. RESTRICT: un período con versiones no se borra en cascada.
model PeriodLiquidationVersion {
  id             String    @id @default(cuid())
  organizationId String
  periodId       String
  version        Int
  closedAt       DateTime
  closedById     String?   @db.Uuid
  /// Versión del motor y de los exportadores (lib/vat-export/version.ts).
  engineVersion  String    @db.VarChar(32)
  contentHash    String    @db.Char(64)
  summary        Json
  packageZip     Bytes?
  packageSha256  String?   @db.Char(64)
  supersededAt   DateTime?
  supersededById String?   @db.Uuid
  /// Motivo de la reapertura (texto del estudio, sin datos de terceros).
  reopenReason   String?   @db.VarChar(500)
  createdAt      DateTime  @default(now())

  period       Period   @relation(fields: [periodId, organizationId], references: [id, organizationId], onUpdate: Cascade, onDelete: Restrict)
  closedBy     Profile? @relation("LiquidationVersionClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  supersededBy Profile? @relation("LiquidationVersionSupersededBy", fields: [supersededById], references: [id], onDelete: SetNull)

  @@unique([periodId, version])
  @@index([periodId, organizationId])
  @@index([organizationId])
}

/// Tarea 3B: traza de auditoría de escrituras de negocio y exportaciones.
/// - `organization` con onDelete: Restrict (el historial NO se borra en cascada).
/// - `actor` opcional con onDelete: SetNull.
/// - `metadata` es JSON SANEADO por lib/auth/audit.ts: nunca contraseñas,
///   tokens, cookies, claves, cadenas de conexión, cuerpos completos ni
///   importes fiscales. Para `client.create` NO incluye el CUIT.
/// - Sin endpoint ni UI en 3B; la lectura futura será sólo OWNER/ADMIN.
model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorProfileId String?  @db.Uuid
  action         String
  targetType     String
  targetId       String
  metadata       Json
  createdAt      DateTime @default(now())

  organization Organization @relation("OrgAuditLogs", fields: [organizationId], references: [id], onDelete: Restrict)
  actor        Profile?     @relation("ProfileAuditLogs", fields: [actorProfileId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([targetType, targetId])
}

/// Se conserva TAL CUAL en 3A (sin uso). Migracion a OrgSetting + cableado de
/// /settings es tarea posterior, fuera de alcance de 3A.
model Settings {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

// ── Ficha IIBB del cliente (informativa) ─────────────────────────────────────

/// Categoría operativa de inscripción en Ingresos Brutos elegida por el estudio.
/// Local, Simplificado y Convenio Multilateral son regímenes; Exento es un
/// tratamiento y No Inscripto una situación (ver lib/iibb/registration.ts). No
/// se infiere de la condición frente al IVA ni determina obligaciones.
enum ClientIibbRegistration {
  LOCAL
  SIMPLIFICADO
  EXENTO
  NO_INSCRIPTO
  CONVENIO_MULTILATERAL
}

/// Nomenclador del código de actividad. Los códigos de nomencladores distintos
/// NO son equivalentes entre sí y no se convierten automáticamente.
enum ActivityNomenclator {
  ARCA
  NAES
  PROVINCIAL
  OTRO
}

/// Jurisdicción IIBB del cliente (código de Convenio Multilateral 901-924).
/// Según la inscripción es una jurisdicción inscripta, alcanzada (CM) o de
/// actividad (No Inscripto). `isHeadquarters`: sede, sólo en CM.
model ClientJurisdiction {
  id               String   @id @default(cuid())
  organizationId   String
  clientId         String
  jurisdictionCode String
  isHeadquarters   Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  client Client               @relation(fields: [clientId, organizationId], references: [id, organizationId], onDelete: Cascade, onUpdate: Cascade)
  rates  ClientActivityRate[]

  @@unique([clientId, jurisdictionCode])
  // Destino de la FK compuesta desde ClientActivityRate (misma organización y cliente).
  @@unique([clientId, organizationId, jurisdictionCode])
  @@index([organizationId])
}

/// Actividad del cliente con su código en un nomenclador identificado.
/// `nomenclatorJurisdiction`: jurisdicción del nomenclador provincial ("" si
/// no aplica). `nomenclatorReference`: referencia libre del nomenclador (p. ej.
/// el número de nomenclador informado por ARCA).
model ClientActivity {
  id                      String              @id @default(cuid())
  organizationId          String
  clientId                String
  nomenclator             ActivityNomenclator
  nomenclatorJurisdiction String              @default("")
  nomenclatorReference    String?
  code                    String
  description             String
  /// CATALOG: copia fija de una entrada de un catálogo oficial versionado
  /// (catalogId + catalogVersion); MANUAL: carga manual o histórica no
  /// catalogada. Una versión nueva del catálogo nunca modifica esta fila.
  origin                  ActivityOrigin      @default(MANUAL)
  catalogId               String?
  catalogVersion          String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  client Client               @relation(fields: [clientId, organizationId], references: [id, organizationId], onDelete: Cascade, onUpdate: Cascade)
  rates  ClientActivityRate[]

  @@unique([clientId, nomenclator, nomenclatorJurisdiction, code])
  // Destino de la FK compuesta desde ClientActivityRate.
  @@unique([id, clientId, organizationId])
  @@index([organizationId])
}

/// Alícuota informativa por actividad y jurisdicción. `rate` NULL = sin
/// informar (distinto de 0 explícito). NO se usa en la liquidación. Tabla
/// separada para poder agregar vigencias por período en el futuro.
model ClientActivityRate {
  id               String        @id @default(cuid())
  organizationId   String
  clientId         String
  activityId       String
  jurisdictionCode String
  rate             Decimal?      @db.Decimal(9, 6)
  /// RATE con rate NULL = sin informar; RATE con rate = alícuota (0 = 0 %
  /// explícito); EXEMPT = exención (rate NULL). Informativo: no se usa en la
  /// liquidación.
  treatment        RateTreatment @default(RATE)
  /// Origen del dato: tasa manual del estudio o sugerencia de norma confirmada
  /// (con ruleRef). NULL = sin origen registrado (cargas previas) o sin dato.
  rateOrigin       RateOrigin?
  ruleRef          String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  activity     ClientActivity     @relation(fields: [activityId, clientId, organizationId], references: [id, clientId, organizationId], onDelete: Cascade, onUpdate: Cascade)
  // onDelete Cascade: al borrar un cliente, sus jurisdicciones y alícuotas se
  // eliminan juntas (con NoAction PostgreSQL verificaba esta FK antes de que la
  // cascada desde la actividad borrara las alícuotas y el borrado fallaba). La
  // protección contra quitas silenciosas está en el servidor: confirmación
  // exacta bajo bloqueo de la fila del cliente (app/api/clients/[id]).
  jurisdiction ClientJurisdiction @relation(fields: [clientId, organizationId, jurisdictionCode], references: [clientId, organizationId, jurisdictionCode], onDelete: Cascade, onUpdate: NoAction)

  @@unique([activityId, jurisdictionCode])
  @@index([clientId])
  @@index([organizationId])
}

/// Origen de una actividad de la ficha.
enum ActivityOrigin {
  CATALOG
  MANUAL
}

/// Tratamiento informativo de una actividad en una jurisdicción.
enum RateTreatment {
  RATE
  EXEMPT
}

/// Origen de una alícuota informativa.
enum RateOrigin {
  STUDIO_MANUAL
  CONFIRMED_SUGGESTION
}

/// Caché operativa del servidor. Credenciales WSAA cifradas AES-256-GCM, nunca datos del padrón.
/// RLS habilitada sin políticas y sin GRANT a roles API; acceso del backend propietario.
model ArcaWsaaTicket {
  key          String    @id
  ciphertext   String?
  expiresAt    DateTime? @db.Timestamptz(3)
  blockedUntil DateTime? @db.Timestamptz(3)
  leaseId      String?
  leaseUntil   DateTime? @db.Timestamptz(3)
  updatedAt    DateTime  @db.Timestamptz(3)
}

/// Interruptor global de la consulta a ARCA en producción (fila única 'global').
/// Se cambia por SQL del operador, sin redeploy. Ausente o false: no se consulta.
model ArcaPadronControl {
  id        String   @id
  enabled   Boolean  @default(false)
  updatedAt DateTime @default(now()) @db.Timestamptz(3)
}

/// Habilitación explícita por organización. Sin fila o false: no se consulta.
model ArcaPadronOrganization {
  organizationId String   @id
  enabled        Boolean  @default(false)
  updatedAt      DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

/// Fila de bloqueo por cupo propio (usuario, organización o certificado). Sin datos personales en claro.
model ArcaLookupQuota {
  key       String   @id
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

/// Consumos de cupo dentro de la ventana más larga; se depuran al consumir.
model ArcaLookupQuotaEvent {
  id  BigInt   @id @default(autoincrement())
  key String
  at  DateTime @db.Timestamptz(3)

  @@index([key, at])
}
