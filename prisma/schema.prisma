generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Client {
  id        String   @id @default(cuid())
  name      String
  cuit      String   @unique
  condition String   // e.g., Responsable Inscripto, Monotributo
  address   String?
  defaultIibbRate Decimal @default(3.000000) @db.Decimal(9, 6)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  periods   Period[]
}

model Period {
  id         String      @id @default(cuid())
  month      Int
  year       Int
  clientId   String
  client     Client      @relation(fields: [clientId], references: [id])
  invoices   Invoice[]
  taxRecords TaxRecord[]

  @@unique([month, year, clientId])
}

model Invoice {
  id          String   @id @default(cuid())
  date        DateTime
  type        String   // e.g., FC A, NC A
  pointOfSale Int
  number      Int
  entityName  String   // Client or Supplier name
  entityCuit  String
  netAmount   Decimal  @db.Decimal(18, 2)
  vatRate     Decimal  @db.Decimal(9, 6) // porcentaje: 21, 10.5, 2.5
  vatAmount   Decimal  @db.Decimal(18, 2)
  totalAmount Decimal  @db.Decimal(18, 2)
  category    String   // SALES or PURCHASES
  periodId    String
  period      Period   @relation(fields: [periodId], references: [id])
}

model TaxRecord {
  id          String   @id @default(cuid())
  date        DateTime
  type        String   // e.g., RETENCION IVA, PERCEPCION IIBB
  amount      Decimal  @db.Decimal(18, 2)
  description String?
  periodId    String
  period      Period   @relation(fields: [periodId], references: [id])
}

model Settings {
  id    String @id @default(cuid())
  key   String @unique
  value String
}
